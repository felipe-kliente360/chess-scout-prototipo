# macOS
.DS_Store

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editores
.vscode/
.idea/
*.swp

# Dados de usuários (PII) — ficam só local
data/*/
data/*.csv
data/*.json
data/history.db
data/history.db-wal
data/history.db-shm
data/history.db.backup-*

# Relatórios PDF (PII) — ficam só local
data-reports/

# Lifecycle do app (PIDs, logs do servidor)
.app-state.json
.app-logs/

# Cache regenerável (2MB, recriado por scripts/export_cache.py)
data/openings/position_cache.json

# Permite as bases CC0 do Lichess (necessárias pro app rodar fresh-clone)
!data/openings/
!data/openings/*.tsv
!data/openings/eco.json

# Permite o índice tático (4MB, gerado a partir do woodpecker puzzles via
# scripts/build_tactical_index.py — necessário pro browser classificar temas)
!data/tactical/
!data/tactical/themes_index.json

# Settings locais
.claude/settings.local.json
